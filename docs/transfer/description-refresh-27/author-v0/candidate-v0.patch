+export function understandingReviewWork(p:Project,areaId:string):{task:Task;changed:boolean}[] {
+  const entries=(items:string[])=>new Map(items.map(s=>{const i=s.indexOf(':');return [s.slice(0,i),s.slice(i+1)] as const;}));
