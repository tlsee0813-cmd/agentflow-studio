{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noEmitOnError": true,
    "rootDir": "candidate-src",
    "outDir": "candidate-dist",
    "sourceMap": false,
    "declaration": false,
    "types": []
  },
  "include": [
    "candidate-src/**/*.ts"
  ]
}
