--- v0/check/run_with_exit.sh	2026-10-16 03:18:57.037666386 +0900
+++ fix1/check/run_with_exit.sh	2026-10-16 03:19:10.920318476 +0900
@@ -23,6 +23,9 @@
 echo "cmd: orientation_check.py <URL> $(basename "$OTHER") probe_hash_mismatch/" >> "$REC"
 echo "exit_code=$P" >> "$REC"
 echo "served HTML file sha256 (after): $(sha256sum "$HTML" | cut -d' ' -f1)" >> "$REC"
-if [ "$N" -eq 0 ] && [ "$P" -ne 0 ]; then echo "결과: 정상 exit 0, 의도한 해시 불일치 exit $P" >> "$REC"
-else echo "결과 이상: 정상 exit $N, 의도한 실패 exit $P" >> "$REC"; fi
